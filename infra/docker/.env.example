# Configuração local de desenvolvimento.
# Copie este arquivo para infra/docker/.env e troque as senhas de exemplo.
MYSQL_DATABASE=recicla_palhoca
MYSQL_USER=recicla_app
MYSQL_PASSWORD=troque_esta_senha_local
MYSQL_ROOT_PASSWORD=troque_esta_senha_root_local
MYSQL_PORT=3307
API_PORT=3000

# Gere uma chave aleatória local de pelo menos 32 bytes; não use o valor de exemplo em produção.
AUTH_JWT_SECRET=
