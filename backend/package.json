{
  "name": "recicla-palhoca-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API backend do projeto Recicla Palhoça",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration:centers": "node scripts/run-centers-integration.cjs",
    "test:integration:centers:http": "node scripts/run-centers-http-integration.cjs"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "mysql2": "3.24.4",
    "bcryptjs": "3.0.3",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/jsonwebtoken": "9.0.10"
  }
}
